---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import CtaBanner from "../components/CtaBanner.astro";

// Published projects only (draft: false), ordered.
const projects = (await getCollection("proyectos", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const hasProjects = projects.length > 0;
---

<Layout
  title="Proyectos — Estudios geofísicos | Iván Bazaldúa"
  description="Casos de estudio de estudios geofísicos en obra civil, minería y agua subterránea: problema, método aplicado y resultado."
>
  <section class="section--soft page-head">
    <!-- Survey network background -->
    <div class="page-head__bg" aria-hidden="true">
      <svg viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <!-- Líneas de conexión -->
        <g class="connections">
          <line x1="100" y1="80" x2="250" y2="120" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.15"/>
          <line x1="250" y1="120" x2="400" y2="90" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.12"/>
          <line x1="400" y1="90" x2="550" y2="140" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.15"/>
          <line x1="550" y1="140" x2="700" y2="100" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.12"/>
          <line x1="700" y1="100" x2="850" y2="160" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.15"/>
          <line x1="850" y1="160" x2="1000" y2="130" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.12"/>
          <line x1="1000" y1="130" x2="1100" y2="180" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.15"/>
          <line x1="250" y1="120" x2="300" y2="200" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.1"/>
          <line x1="550" y1="140" x2="600" y2="220" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.1"/>
          <line x1="850" y1="160" x2="900" y2="240" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.1"/>
          <line x1="100" y1="80" x2="200" y2="40" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.1"/>
          <line x1="400" y1="90" x2="480" y2="50" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.1"/>
          <line x1="700" y1="100" x2="780" y2="60" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.1"/>
          <line x1="1100" y1="180" x2="1150" y2="140" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.1"/>
        </g>
        <!-- Puntos de estación -->
        <g class="stations">
          <circle class="station" cx="100" cy="80" r="3" fill="var(--color-electric)" opacity="0.3"/>
          <circle class="station" cx="250" cy="120" r="4" fill="var(--color-electric)" opacity="0.4"/>
          <circle class="station" cx="400" cy="90" r="3" fill="var(--color-electric)" opacity="0.3"/>
          <circle class="station" cx="550" cy="140" r="4" fill="var(--color-electric)" opacity="0.4"/>
          <circle class="station" cx="700" cy="100" r="3" fill="var(--color-electric)" opacity="0.3"/>
          <circle class="station" cx="850" cy="160" r="4" fill="var(--color-electric)" opacity="0.4"/>
          <circle class="station" cx="1000" cy="130" r="3" fill="var(--color-electric)" opacity="0.3"/>
          <circle class="station" cx="1100" cy="180" r="4" fill="var(--color-electric)" opacity="0.4"/>
          <!-- Puntos intermedios -->
          <circle class="station" cx="200" cy="40" r="2" fill="var(--color-electric)" opacity="0.2"/>
          <circle class="station" cx="300" cy="200" r="2" fill="var(--color-electric)" opacity="0.2"/>
          <circle class="station" cx="480" cy="50" r="2" fill="var(--color-electric)" opacity="0.2"/>
          <circle class="station" cx="600" cy="220" r="2" fill="var(--color-electric)" opacity="0.2"/>
          <circle class="station" cx="780" cy="60" r="2" fill="var(--color-electric)" opacity="0.2"/>
          <circle class="station" cx="900" cy="240" r="2" fill="var(--color-electric)" opacity="0.2"/>
          <circle class="station" cx="1150" cy="140" r="2" fill="var(--color-electric)" opacity="0.2"/>
        </g>
      </svg>
    </div>

    <div class="container">
      <p class="eyebrow">Proyectos</p>
      <h1>Proyectos</h1>
      <p class="page-head__lead">
        Estudios geofísicos realizados en campo para resolver problemas reales
        de obra civil, minería y agua subterránea.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        hasProjects ? (
          <div class="project-grid">
            {projects.map((p) => (
              <article class="project">
                {p.data.image && (
                  <div class="project__media">
                    <img src={p.data.image.src} alt={p.data.title} loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="project__body">
                  <span class="project__sector">{p.data.sector}</span>
                  <h2 class="project__title">
                    <a href={`/proyectos/${p.id}`}>{p.data.title}</a>
                  </h2>
                  <dl>
                    <div><dt>Ubicación</dt><dd>{p.data.location}</dd></div>
                    <div><dt>Método</dt><dd>{p.data.method}</dd></div>
                    <div><dt>Objetivo</dt><dd>{p.data.objective}</dd></div>
                    <div><dt>Resultado</dt><dd>{p.data.result}</dd></div>
                  </dl>
                  <Button href={`/proyectos/${p.id}`} variant="secondary" class="project__link">
                    Ver caso de estudio
                  </Button>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="placeholder">
            <h2>Portafolio en preparación</h2>
            <p>
              Estoy documentando una selección de estudios representativos.
              Mientras tanto, si quieres conocer casos similares al tuyo,
              escríbeme y con gusto te comparto ejemplos relevantes.
            </p>
            <Button href="/contacto" variant="primary">Contáctame</Button>
          </div>
        )
      }
    </div>
  </section>

  {hasProjects && <CtaBanner heading="¿Tu proyecto se parece a alguno de estos?" />}
</Layout>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-24) var(--space-16);
  }
  .page-head__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .page-head__bg svg {
    width: 100%;
    height: 100%;
  }
  .page-head > .container {
    position: relative;
    z-index: 1;
  }
  .page-head__lead {
    max-width: 60ch;
    margin-top: var(--space-4);
    font-size: 1.125rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .station {
      animation: stationPulse 3s ease-in-out infinite;
    }
    .station:nth-child(2) { animation-delay: 0.3s; }
    .station:nth-child(3) { animation-delay: 0.6s; }
    .station:nth-child(4) { animation-delay: 0.9s; }
    .station:nth-child(5) { animation-delay: 1.2s; }
    .station:nth-child(6) { animation-delay: 1.5s; }
    .station:nth-child(7) { animation-delay: 1.8s; }
    .station:nth-child(8) { animation-delay: 2.1s; }
    @keyframes stationPulse {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 0.6; }
    }
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-8);
  }
  .project {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--color-surface);
  }
  .project__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .project__body {
    padding: var(--space-6);
  }
  .project__sector {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-text);
    margin-bottom: var(--space-2);
  }
  .project__title {
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
  }
  .project__title a {
    text-decoration: none;
    color: inherit;
  }
  .project__title a:hover {
    color: var(--color-accent-text);
  }
  .project dl div {
    padding-block: var(--space-2);
    border-top: 1px solid var(--color-border);
  }
  .project dt {
    font-family: var(--font-heading);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }
  .project dd {
    margin-top: var(--space-1);
  }
  .project__link {
    margin-top: var(--space-6);
  }
  .placeholder {
    text-align: center;
    max-width: 560px;
    margin-inline: auto;
    padding: var(--space-16) var(--space-6);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
  }
  .placeholder p {
    margin: var(--space-4) auto var(--space-8);
    color: var(--text-secondary);
  }
</style>
