---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import CtaBanner from "../components/CtaBanner.astro";

const education = [
  {
    degree: "Maestría en Ciencias en Geofísica Aplicada",
    school:
      "CICESE — Centro de Investigación Científica y de Educación Superior de Ensenada",
  },
  {
    degree: "Ingeniero Geofísico",
    school: "Universidad Autónoma de Nuevo León (UANL)",
  },
];

const skills = [
  { group: "Métodos eléctricos", items: "TRE · Potencial Inducido (IP) · Resistividad de suelos" },
  { group: "Métodos sísmicos", items: "Tomografía de Refracción Sísmica (TRS) · MASW" },
  { group: "Electromagnético", items: "Georradar (GPR)" },
  { group: "Procesamiento e interpretación", items: "Res2DInv · ZondST2D · SeisImager · EasyMASW · ResIPy · Surfer · QGIS · AutoCAD" },
];
---

<Layout
  title="Sobre mí — Iván Bazaldúa, M.C. Geofísica Aplicada"
  description="Ingeniero Geofísico (UANL) y Maestro en Ciencias en Geofísica Aplicada (CICESE), especializado en estudios del subsuelo con métodos no invasivos."
>
  <section class="section--soft page-head">
    <!-- Electrode grid waves background -->
    <div class="page-head__bg" aria-hidden="true">
      <svg viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <!-- Líneas de electrodos horizontales -->
        <line x1="0" y1="60" x2="1200" y2="60" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.12"/>
        <line x1="0" y1="120" x2="1200" y2="120" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.12"/>
        <line x1="0" y1="180" x2="1200" y2="180" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.12"/>
        <line x1="0" y1="240" x2="1200" y2="240" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.12"/>
        <!-- Ondas emanando hacia abajo desde cada electrodo -->
        <g class="electrode-wave">
          <circle cx="100" cy="60" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M100,60 Q100,100 100,140 Q100,180 100,220" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
          <circle cx="200" cy="120" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M200,120 Q200,160 200,200 Q200,240 200,280" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
          <circle cx="300" cy="60" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M300,60 Q300,100 300,140 Q300,180 300,220" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
          <circle cx="400" cy="180" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M400,180 Q400,220 400,260" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
          <circle cx="500" cy="120" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M500,120 Q500,160 500,200 Q500,240 500,280" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
          <circle cx="600" cy="60" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M600,60 Q600,100 600,140 Q600,180 600,220" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
          <circle cx="700" cy="240" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M700,240 Q700,270 700,300" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
          <circle cx="800" cy="120" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M800,120 Q800,160 800,200 Q800,240 800,280" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
          <circle cx="900" cy="60" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M900,60 Q900,100 900,140 Q900,180 900,220" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
          <circle cx="1000" cy="180" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M1000,180 Q1000,220 1000,260" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
          <circle cx="1100" cy="120" r="2" fill="var(--color-electric)" opacity="0.3"/>
          <path d="M1100,120 Q1100,160 1100,200 Q1100,240 1100,280" stroke="var(--color-electric)" stroke-width="0.5" fill="none" opacity="0.15"/>
        </g>
      </svg>
    </div>

    <div class="container">
      <p class="eyebrow">Sobre mí</p>
      <h1>Sobre mí</h1>
    </div>
  </section>

  <section class="section">
    <div class="container intro">
      <div class="intro__photo">
        <img src="/img/ICBR_2.png" alt="Iván Bazaldúa" width="260" height="260" />
      </div>
      <div class="intro__text">
        <p>
          Soy <strong>Iván Bazaldúa</strong>, Ingeniero Geofísico y Maestro en
          Ciencias en Geofísica Aplicada. Me especializo en estudios del
          subsuelo con métodos geofísicos no invasivos, ayudando a profesionales
          y empresas de obra civil, minería y recursos hídricos a tomar
          decisiones respaldadas en datos confiables.
        </p>
        <p>
          Mi trabajo combina el rigor científico de la geofísica con un enfoque
          práctico: no entrego solo mediciones, entrego interpretaciones claras
          y recomendaciones aplicables a tu proyecto.
        </p>
        <Button href="/img/ICBR_CV_2025.pdf" variant="secondary">
          Descargar CV
        </Button>
      </div>
    </div>
  </section>

  <hr class="wave-divider" />

  <section class="section section--soft">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Formación</p>
        <h2>Respaldo académico</h2>
        <ul class="education">
          {
            education.map((e) => (
              <li class="education__item">
                <h3>{e.degree}</h3>
                <p>{e.school}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow">Especialidades técnicas</p>
        <h2>Métodos y herramientas</h2>
        <ul class="skills">
          {
            skills.map((s) => (
              <li class="skills__item">
                <h3>{s.group}</h3>
                <p>{s.items}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <CtaBanner
    heading="¿Quieres saber si tu proyecto es viable con estudios geofísicos?"
  />
</Layout>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-24) var(--space-16);
  }
  .page-head__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .page-head__bg svg {
    width: 100%;
    height: 100%;
  }
  .page-head > .container {
    position: relative;
    z-index: 1;
  }
  .intro {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: var(--space-12);
    align-items: center;
  }
  .intro__photo {
    display: flex;
    justify-content: center;
  }
  .intro__photo img {
    width: 260px;
    height: 260px;
    object-fit: cover;
    border-radius: var(--radius-full);
    border: 6px solid var(--color-electric);
    box-shadow: var(--shadow-md);
  }
  .intro__text p {
    margin-bottom: var(--space-4);
    font-size: 1.0625rem;
  }
  .intro__text :global(.btn) {
    margin-top: var(--space-2);
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
  }
  .two-col h2 {
    margin-top: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .education__item,
  .skills__item {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .education__item h3 {
    font-size: 1.125rem;
  }
  .education__item p,
  .skills__item p {
    color: var(--text-secondary);
    margin-top: var(--space-1);
  }
  .skills__item h3 {
    font-size: 1rem;
    color: var(--color-accent-text);
  }
  @media (max-width: 860px) {
    .intro,
    .two-col {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .intro__photo {
      order: -1;
    }
  }
</style>
