---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import Prose from "../../components/Prose.astro";
import { site } from "../../data/site.ts";

export async function getStaticPaths() {
  const projects = await getCollection("proyectos", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const pageTitle = project.data.title;
const pageDescription =
  `${project.data.sector}: ${project.data.method}. ${project.data.objective}`;
const pageUrl = new URL(`/proyectos/${project.id}`, site.url).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  about: [project.data.method, project.data.sector],
  author: { "@type": "Person", name: site.name, url: site.url },
  provider: {
    "@type": "ProfessionalService",
    name: "Iván Bazaldúa — Geofísica Aplicada",
    url: site.url,
  },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
};
---

<Layout
  title={`${pageTitle} — Iván Bazaldúa`}
  description={pageDescription}
  ogType="article"
>
  <section class="section--soft page-head">
    <svg
      class="page-head__field-art"
      viewBox="0 0 520 360"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <circle cx="80" cy="180" r="14" fill="var(--color-electric)" opacity="0.7"/>
      <circle cx="80" cy="180" r="22" fill="none" stroke="var(--color-electric)" stroke-width="1" opacity="0.25"/>
      <circle cx="80" cy="180" r="32" fill="none" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.15"/>
      <circle cx="440" cy="180" r="14" fill="var(--color-electric)" opacity="0.7"/>
      <circle cx="440" cy="180" r="22" fill="none" stroke="var(--color-electric)" stroke-width="1" opacity="0.25"/>
      <circle cx="440" cy="180" r="32" fill="none" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.15"/>
      <path class="field-line" d="M80,180 Q260,40 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.55" stroke-dasharray="8 4"/>
      <path class="field-line" d="M80,180 Q260,75 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.45" stroke-dasharray="8 4"/>
      <path class="field-line" d="M80,180 Q260,110 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.38" stroke-dasharray="8 4"/>
      <path class="field-line" d="M80,180 Q260,145 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.32" stroke-dasharray="8 4"/>
      <path class="field-line" d="M80,180 Q260,180 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.65" stroke-dasharray="8 4"/>
      <path class="field-line" d="M80,180 Q260,215 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.32" stroke-dasharray="8 4"/>
      <path class="field-line" d="M80,180 Q260,250 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.38" stroke-dasharray="8 4"/>
      <path class="field-line" d="M80,180 Q260,285 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.45" stroke-dasharray="8 4"/>
      <path class="field-line" d="M80,180 Q260,320 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.55" stroke-dasharray="8 4"/>
      <path class="field-line" d="M80,180 Q50,260 20,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.22" stroke-dasharray="6 3"/>
      <path class="field-line" d="M80,180 Q70,260 55,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.18" stroke-dasharray="6 3"/>
      <path class="field-line" d="M80,180 Q90,260 85,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.14" stroke-dasharray="6 3"/>
      <path class="field-line" d="M440,180 Q470,260 500,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.22" stroke-dasharray="6 3"/>
      <path class="field-line" d="M440,180 Q450,260 465,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.18" stroke-dasharray="6 3"/>
      <path class="field-line" d="M440,180 Q430,260 435,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.14" stroke-dasharray="6 3"/>
    </svg>

    <div class="container">
      <nav class="breadcrumbs" aria-label="Ruta de navegación">
        <a href="/proyectos">Proyectos</a>
        <span aria-hidden="true">/</span>
        <span>{project.data.title}</span>
      </nav>
      <p class="eyebrow">Caso de estudio · {project.data.sector}</p>
      <h1>{pageTitle}</h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Prose>
        <Content />
      </Prose>
    </div>
  </section>

  <div class="circuit-divider" aria-hidden="true">
    <svg viewBox="0 0 800 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <line x1="0" y1="20" x2="800" y2="20" stroke="var(--color-electric)" stroke-width="1" opacity="0.2"/>
      <path d="M100 20 L130 20 L145 8 L200 8" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.35"/>
      <path d="M200 8 L215 8 L230 20 L280 20" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.35"/>
      <path d="M280 20 L310 20 L325 35 L400 35" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.35"/>
      <path d="M400 35 L415 35 L430 20 L480 20" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.35"/>
      <path d="M480 20 L510 20 L525 5 L580 5" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.35"/>
      <path d="M580 5 L595 5 L610 20 L660 20" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.35"/>
      <path d="M660 20 L690 20 L710 32 L800 32" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.35"/>
      <circle cx="200" cy="8" r="3" fill="var(--color-electric)" opacity="0.5"/>
      <circle cx="280" cy="20" r="3" fill="var(--color-electric)" opacity="0.5"/>
      <circle cx="400" cy="35" r="3" fill="var(--color-electric)" opacity="0.5"/>
      <circle cx="480" cy="20" r="3" fill="var(--color-electric)" opacity="0.5"/>
      <circle cx="580" cy="5" r="3" fill="var(--color-electric)" opacity="0.5"/>
      <circle cx="660" cy="20" r="3" fill="var(--color-electric)" opacity="0.5"/>
      <circle cx="100" cy="20" r="2" fill="var(--color-electric)" opacity="0.3"/>
      <circle cx="310" cy="20" r="2" fill="var(--color-electric)" opacity="0.3"/>
      <circle cx="525" cy="20" r="2" fill="var(--color-electric)" opacity="0.3"/>
      <circle cx="710" cy="32" r="2" fill="var(--color-electric)" opacity="0.3"/>
    </svg>
  </div>

  <CtaBanner
    heading="¿Tu proyecto se parece a alguno de estos?"
    text="Cuéntame tu objetivo y te propongo el estudio adecuado."
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-24) var(--space-16);
  }
  .page-head::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 90% at 50% 50%, rgba(0,168,204,0.12) 0%, transparent 70%);
    z-index: 0;
    pointer-events: none;
  }
  .page-head__field-art {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(90vw, 900px);
    height: auto;
    opacity: 0.11;
    z-index: 1;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .page-head::before {
      animation: breathingGlow 8s ease-in-out infinite;
    }
    @keyframes breathingGlow {
      0%, 100% { opacity: 0.6; }
      50% { opacity: 1; }
    }
    .field-line {
      animation: fieldFlow 4s linear infinite;
    }
    @keyframes fieldFlow {
      0% { stroke-dashoffset: 0; }
      100% { stroke-dashoffset: -40; }
    }
  }
  .page-head .container {
    position: relative;
    z-index: 2;
  }
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-small);
  }
  .breadcrumbs a {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* Styles for MDX-rendered content inside Prose */
  :global(.prose) .page-head__lead {
    margin-top: var(--space-4);
    font-size: 1.125rem;
    color: var(--text-primary);
    max-width: none;
  }
  :global(.prose) .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  :global(.prose) .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-full);
    font-family: var(--font-heading);
    font-weight: var(--weight-heading-semibold);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    border: 2px solid transparent;
    text-decoration: none;
    transition:
      background-color var(--transition-base),
      color var(--transition-base),
      border-color var(--transition-base),
      transform var(--transition-fast);
  }
  :global(.prose) .btn:hover {
    transform: translateY(-2px);
  }
  :global(.prose) .btn:active {
    transform: translateY(0);
  }
  :global(.prose) .btn--primary {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
  }
  :global(.prose) .btn--primary:hover {
    background-color: var(--color-accent-hover);
  }
  :global(.prose) .btn--secondary {
    background-color: transparent;
    color: var(--color-accent-text);
    border-color: var(--color-electric);
  }
  :global(.prose) .btn--secondary:hover {
    background-color: var(--color-electric);
    color: var(--color-white);
  }
  :global(.prose) .summary,
  :global(.prose) .result-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  :global(.prose) .summary {
    padding: var(--space-6);
    margin: var(--space-8) 0;
  }
  :global(.prose) .summary dl div {
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  :global(.prose) .summary dl div:first-child {
    border-top: 0;
    padding-top: 0;
  }
  :global(.prose) dt {
    font-family: var(--font-heading);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }
  :global(.prose) dd {
    margin-top: var(--space-1);
  }
  :global(.prose) .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
    margin: var(--space-8) 0;
    max-width: none;
  }
  :global(.prose) .stat {
    padding: var(--space-6);
    border-left: 3px solid var(--color-electric);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  :global(.prose) .stat strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 2rem;
    line-height: 1;
    color: var(--color-accent-text);
    font-weight: var(--weight-heading-semibold);
  }
  :global(.prose) .stat span {
    display: block;
    margin-top: var(--space-2);
    color: var(--text-secondary);
  }
  :global(.prose) .note {
    padding: var(--space-4);
    border-left: 3px solid var(--color-electric);
    background: var(--color-surface);
    margin: var(--space-4) 0;
  }
  :global(.prose) .result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6);
    margin: var(--space-6) 0;
    max-width: none;
  }
  :global(.prose) .result-card {
    padding: var(--space-6);
  }
  :global(.prose) .result-card h3 {
    margin-bottom: var(--space-3);
  }
  :global(.prose) .result-card p,
  :global(.prose) .result-note,
  :global(.prose) .value-list {
    color: var(--text-secondary);
  }
  :global(.prose) .result-note {
    margin-top: var(--space-4);
    max-width: 78ch;
  }
  :global(.prose) .value-list {
    display: grid;
    gap: var(--space-3);
    list-style: disc;
    padding-left: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .circuit-divider {
    display: flex;
    justify-content: center;
    padding-block: var(--space-4);
    overflow: hidden;
  }
  .circuit-divider svg {
    width: 100%;
    max-width: 100%;
    height: auto;
  }
</style>
