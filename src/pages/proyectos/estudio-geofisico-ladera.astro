---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { site } from "../../data/site.ts";

const pageTitle = "Estudio geofísico en ladera para orientar cimentaciones, cortes y drenaje";
const pageDescription =
  "Caso de estudio de TRE en ladera para reducir incertidumbre geotécnica en cortes, drenaje, plataformas y cimentaciones sin exponer datos privados.";
const pageUrl = new URL("/proyectos/estudio-geofisico-ladera/", site.url).href;

const stats = [
  ["6", "perfiles TRE"],
  ["576 m", "lineales explorados"],
  ["15 m", "profundidad aproximada"],
  ["3", "unidades geoeléctricas"],
];

const results = [
  {
    title: "Estrato superficial",
    text: "Sectores con materiales coluviales y suelos finos de menor competencia relativa, con espesores aproximados de 2 a 5 metros.",
  },
  {
    title: "Zona de transición",
    text: "Material variable asociado con conglomerado o roca sedimentaria fracturada e intemperizada, con espesores estimados de 3 a 10 metros.",
  },
  {
    title: "Estrato de mayor competencia",
    text: "Unidad de alta resistividad interpretada como roca relativamente sana o conglomerado cementado, sujeta a verificación geotécnica directa.",
  },
];

const value = [
  "Orientar sondeos y calicatas hacia zonas de transición y mayor incertidumbre.",
  "Reducir el riesgo de asentamientos diferenciales por cambios de rigidez.",
  "Anticipar condiciones de excavación y posibles necesidades de equipo pesado.",
  "Apoyar el diseño de plataformas, cimentaciones, taludes y drenaje.",
];

const decisions = [
  "Dónde concentrar sondeos para validar las zonas de mayor incertidumbre.",
  "Qué sectores requieren mayor atención geotécnica antes del diseño.",
  "Dónde podría encontrarse material competente a menor profundidad.",
  "Qué zonas conviene revisar para drenaje y estabilidad de taludes.",
  "Cómo anticipar variaciones laterales antes de definir plataformas y cortes.",
];

const limitations = [
  "La TRE entrega un modelo indirecto de resistividad eléctrica.",
  "Las interpretaciones deben validarse con sondeos, calicatas o ensayos.",
  "La profundidad efectiva depende de geometría, arreglo, ruido y condiciones del terreno.",
  "Los resultados orientan exploración directa y reducen incertidumbre.",
];

const caseStudyJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  about: [
    "Tomografía de Resistividad Eléctrica",
    "Geotecnia para obra civil",
    "Cimentaciones en ladera",
    "Drenaje y cortes de terreno",
  ],
  author: {
    "@type": "Person",
    name: site.name,
    url: site.url,
  },
  provider: {
    "@type": "ProfessionalService",
    name: "Iván Bazaldúa — Geofísica Aplicada",
    url: site.url,
  },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
};
---

<Layout
  title={`${pageTitle} — Iván Bazaldúa`}
  description={pageDescription}
  ogType="article"
>
  <section class="section--soft page-head">
    <!-- Electric field background art — TRE visualization -->
    <svg
      class="page-head__field-art"
      viewBox="0 0 520 360"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- Electrodo izquierdo -->
      <circle cx="80" cy="180" r="14" fill="var(--color-electric)" opacity="0.7"/>
      <circle cx="80" cy="180" r="22" fill="none" stroke="var(--color-electric)" stroke-width="1" opacity="0.25"/>
      <circle cx="80" cy="180" r="32" fill="none" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.15"/>

      <!-- Electrodo derecho -->
      <circle cx="440" cy="180" r="14" fill="var(--color-electric)" opacity="0.7"/>
      <circle cx="440" cy="180" r="22" fill="none" stroke="var(--color-electric)" stroke-width="1" opacity="0.25"/>
      <circle cx="440" cy="180" r="32" fill="none" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.15"/>

      <!-- Líneas de campo: arcos entre electrodos -->
      <path class="field-line" d="M80,180 Q260,40 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.55"/>
      <path class="field-line" d="M80,180 Q260,75 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.45"/>
      <path class="field-line" d="M80,180 Q260,110 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.38"/>
      <path class="field-line" d="M80,180 Q260,145 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.32"/>
      <path class="field-line" d="M80,180 Q260,180 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.65"/>
      <path class="field-line" d="M80,180 Q260,215 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.32"/>
      <path class="field-line" d="M80,180 Q260,250 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.38"/>
      <path class="field-line" d="M80,180 Q260,285 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.45"/>
      <path class="field-line" d="M80,180 Q260,320 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.55"/>

      <!-- Líneas profundas hacia abajo (corrientes subsuperficiales) -->
      <path class="field-line" d="M80,180 Q50,260 20,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.22"/>
      <path class="field-line" d="M80,180 Q70,260 55,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.18"/>
      <path class="field-line" d="M80,180 Q90,260 85,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.14"/>

      <path class="field-line" d="M440,180 Q470,260 500,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.22"/>
      <path class="field-line" d="M440,180 Q450,260 465,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.18"/>
      <path class="field-line" d="M440,180 Q430,260 435,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.14"/>
    </svg>

    <div class="container page-head__grid">
      <div>
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <a href="/proyectos">Proyectos</a>
          <span aria-hidden="true">/</span>
          <span>Caso TRE en ladera</span>
        </nav>
        <p class="eyebrow">Caso de estudio · Obra civil</p>
        <h1>{pageTitle}</h1>
        <p class="page-head__lead">
          Mediante Tomografía de Resistividad Eléctrica se obtuvo un modelo
          continuo del subsuelo hasta aproximadamente 15 metros de profundidad
          para orientar la exploración geotécnica, las cimentaciones, los cortes
          y el drenaje del proyecto.
        </p>
        <div class="actions">
          <Button href="/contacto" variant="primary">Solicitar evaluación</Button>
          <Button href="/proyectos" variant="secondary">Volver a proyectos</Button>
        </div>
      </div>
      <aside class="summary" aria-label="Resumen del caso">
        <dl>
          <div><dt>Ubicación general</dt><dd>Zona de ladera</dd></div>
          <div><dt>Entorno</dt><dd>Terreno de ladera próximo a macizo montañoso</dd></div>
          <div><dt>Método</dt><dd>Tomografía de Resistividad Eléctrica (TRE)</dd></div>
          <div><dt>Aplicación</dt><dd>Planeación preliminar de desarrollo inmobiliario</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container stats" aria-label="Cifras del estudio">
      {stats.map(([number, label]) => (
        <div class="stat">
          <strong>{number}</strong>
          <span>{label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--soft">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">El reto</p>
        <h2>Entender la variación del subsuelo antes de construir</h2>
      </div>
      <div class="copy">
        <p>
          El predio presentaba topografía accidentada, pendientes importantes,
          escurrimientos superficiales y una distribución variable de depósitos
          coluviales, conglomerados y roca sedimentaria.
        </p>
        <p>
          El proyecto necesitaba conocer cómo cambiaban los materiales lateralmente
          y en profundidad antes de definir plataformas, cortes y criterios de
          cimentación. Una exploración basada solo en puntos aislados podía dejar
          sin identificar transiciones relevantes entre suelo, roca alterada y
          materiales de mayor competencia.
        </p>
        <p>
          Sin esa lectura previa, el riesgo comercial era claro: sobrecostos por
          cortes no previstos, estabilización adicional, excavación difícil,
          drenaje insuficiente o cambios de cimentación durante la obra.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">Método</p>
        <h2>Seis líneas de TRE para construir una lectura continua</h2>
      </div>
      <div class="copy">
        <p>
          Se ejecutaron seis líneas de Tomografía de Resistividad Eléctrica en
          áreas accesibles y representativas. La configuración Wenner–Schlumberger
          permitió equilibrar profundidad de investigación, resolución lateral y
          calidad de señal.
        </p>
        <p class="note">
          La TRE es un método indirecto: reduce incertidumbre y dirige mejor la
          exploración geotécnica, pero no sustituye sondeos, muestreo ni ensayos
          de laboratorio o campo.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__header">
        <p class="eyebrow">Resultados</p>
        <h2>Tres unidades con implicaciones geotécnicas distintas</h2>
      </div>
      <div class="result-grid">
        {results.map((item) => (
          <article class="result-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <p class="result-note">
        En los sectores bajos de la ladera aumentó el espesor de depósitos
        superficiales y de transición. En las partes altas, el material competente
        apareció más somero. Dentro de la profundidad explorada no se identificaron
        respuestas compatibles con cavidades ni con nivel freático.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">Valor aportado</p>
        <h2>Una guía práctica para la siguiente etapa del proyecto</h2>
      </div>
      <ul class="value-list">
        {value.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">Decisiones que facilitó el estudio</p>
        <h2>Pasar de supuestos generales a prioridades de investigación</h2>
      </div>
      <ul class="value-list">
        {decisions.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">Alcance y limitaciones</p>
        <h2>Qué puede y qué no puede confirmar una TRE</h2>
      </div>
      <ul class="value-list">
        {limitations.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--soft privacy">
    <div class="container">
      <p class="eyebrow">Privacidad del caso</p>
      <h2>Información publicada de forma anonimizada</h2>
      <p>
        Este caso omite nombre del proyecto, coordenadas, accesos, mapas de
        ubicación, predios colindantes, fotografías identificables y planos que
        permitan reconstruir la localización exacta.
      </p>
    </div>
  </section>

  <CtaBanner
    heading="¿Vas a construir en una ladera o terreno irregular?"
    text="Puedo ayudarte a definir dónde investigar antes de diseñar cortes, plataformas o cimentaciones."
    buttonLabel="Evaluar mi terreno"
  />

  <script type="application/ld+json" set:html={JSON.stringify(caseStudyJsonLd)} />
</Layout>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-24) var(--space-16);
  }
  .page-head::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 90% at 85% 50%, rgba(0,168,204,0.09) 0%, transparent 65%),
      radial-gradient(ellipse 50% 70% at 15% 50%, rgba(0,80,120,0.06) 0%, transparent 55%);
    z-index: 0;
    pointer-events: none;
  }
  .page-head__field-art {
    position: absolute;
    right: -6%;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(280px, 42vw, 520px);
    height: auto;
    opacity: 0.13;
    z-index: 1;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .field-line {
      animation: fieldPulse 5s ease-in-out infinite;
    }
    @keyframes fieldPulse {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 0.7; }
    }
  }
  .page-head__grid,
  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr);
    gap: var(--space-12);
    align-items: start;
    position: relative;
    z-index: 2;
  }
  .page-head__lead {
    margin-top: var(--space-4);
    font-size: 1.125rem;
    color: var(--text-primary);
  }
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-small);
  }
  .breadcrumbs a {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .summary,
  .result-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .summary {
    padding: var(--space-6);
  }
  .summary dl div {
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  .summary dl div:first-child {
    border-top: 0;
    padding-top: 0;
  }
  dt {
    font-family: var(--font-heading);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }
  dd {
    margin-top: var(--space-1);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
  }
  .stat {
    padding: var(--space-6);
    border-left: 3px solid var(--color-electric);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .stat strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 2rem;
    line-height: 1;
    color: var(--color-accent-text);
  }
  .stat span {
    display: block;
    margin-top: var(--space-2);
    color: var(--text-secondary);
  }
  .copy p + p {
    margin-top: var(--space-4);
  }
  .note {
    padding: var(--space-4);
    border-left: 3px solid var(--color-electric);
    background: var(--color-surface);
  }
  .result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6);
  }
  .result-card {
    padding: var(--space-6);
  }
  .result-card h3 {
    margin-bottom: var(--space-3);
  }
  .result-card p,
  .result-note,
  .value-list,
  .privacy p {
    color: var(--text-secondary);
  }
  .result-note {
    margin-top: var(--space-8);
    max-width: 78ch;
  }
  .value-list {
    display: grid;
    gap: var(--space-3);
    list-style: disc;
    padding-left: var(--space-6);
  }
  .privacy p {
    margin-top: var(--space-4);
    max-width: 72ch;
  }
  @media (max-width: 760px) {
    .page-head__grid,
    .content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
