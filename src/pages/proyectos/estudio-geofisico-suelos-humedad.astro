---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { site } from "../../data/site.ts";

const pageTitle = "TRE para identificar humedad y suelos finos antes del diseño de cimentaciones";
const pageDescription =
  "Caso de estudio de TRE para ubicar humedad y suelos finos que pueden afectar cimentaciones, losas, drenaje y mantenimiento sin exponer datos privados.";
const pageUrl = new URL("/proyectos/estudio-geofisico-suelos-humedad/", site.url).href;

const stats = [
  ["2", "perfiles TRE"],
  ["10 m", "profundidad aproximada"],
  ["2", "unidades geoeléctricas"],
  ["0", "indicios de cavidades"],
];

const findings = [
  {
    title: "Zonas de muy baja resistividad",
    text: "Anomalías asociadas preliminarmente con mayor humedad o saturación local, que deben verificarse mediante sondeos y ensayos geotécnicos.",
  },
  {
    title: "Suelos finos dominantes",
    text: "Materiales arcilloso-limosos con contenido variable de arena en los primeros metros del terreno.",
  },
];

const value = [
  "Ubicar sondeos donde conviene verificar las anomalías de humedad.",
  "Priorizar ensayos de plasticidad, expansión, consolidación y capacidad de carga.",
  "Considerar drenaje perimetral, pendientes superficiales e impermeabilización.",
  "Reducir cambios durante obra por condiciones de humedad no previstas.",
];

const decisions = [
  "Dónde verificar humedad con sondeos o exploración directa.",
  "Qué ensayos priorizar para evaluar plasticidad, expansión y consolidación.",
  "Qué zonas conviene considerar para drenaje y control de agua.",
  "Qué áreas pueden tener comportamiento sensible por finos y humedad.",
];

const limitations = [
  "La TRE entrega un modelo indirecto de resistividad eléctrica.",
  "Las interpretaciones deben validarse con sondeos, calicatas o ensayos.",
  "La profundidad efectiva depende de geometría, arreglo, ruido y condiciones del terreno.",
  "Los resultados orientan exploración directa y reducen incertidumbre.",
];

const caseStudyJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: pageTitle,
  description: pageDescription,
  about: [
    "Tomografía de Resistividad Eléctrica",
    "Suelos finos",
    "Humedad del subsuelo",
    "Diseño de cimentaciones",
  ],
  author: {
    "@type": "Person",
    name: site.name,
    url: site.url,
  },
  provider: {
    "@type": "ProfessionalService",
    name: "Iván Bazaldúa — Geofísica Aplicada",
    url: site.url,
  },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
};
---

<Layout
  title={`${pageTitle} — Iván Bazaldúa`}
  description={pageDescription}
  ogType="article"
>
  <section class="section--soft page-head">
    <!-- Electric field background art — TRE visualization -->
    <svg
      class="page-head__field-art"
      viewBox="0 0 520 360"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- Electrodo izquierdo -->
      <circle cx="80" cy="180" r="14" fill="var(--color-electric)" opacity="0.7"/>
      <circle cx="80" cy="180" r="22" fill="none" stroke="var(--color-electric)" stroke-width="1" opacity="0.25"/>
      <circle cx="80" cy="180" r="32" fill="none" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.15"/>

      <!-- Electrodo derecho -->
      <circle cx="440" cy="180" r="14" fill="var(--color-electric)" opacity="0.7"/>
      <circle cx="440" cy="180" r="22" fill="none" stroke="var(--color-electric)" stroke-width="1" opacity="0.25"/>
      <circle cx="440" cy="180" r="32" fill="none" stroke="var(--color-electric)" stroke-width="0.5" opacity="0.15"/>

      <!-- Líneas de campo: arcos entre electrodos -->
      <path class="field-line" d="M80,180 Q260,40 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.55"/>
      <path class="field-line" d="M80,180 Q260,75 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.45"/>
      <path class="field-line" d="M80,180 Q260,110 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.38"/>
      <path class="field-line" d="M80,180 Q260,145 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.32"/>
      <path class="field-line" d="M80,180 Q260,180 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.65"/>
      <path class="field-line" d="M80,180 Q260,215 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.32"/>
      <path class="field-line" d="M80,180 Q260,250 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.38"/>
      <path class="field-line" d="M80,180 Q260,285 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.45"/>
      <path class="field-line" d="M80,180 Q260,320 440,180" stroke="var(--color-electric)" stroke-width="1.5" fill="none" opacity="0.55"/>

      <!-- Líneas profundas hacia abajo (corrientes subsuperficiales) -->
      <path class="field-line" d="M80,180 Q50,260 20,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.22"/>
      <path class="field-line" d="M80,180 Q70,260 55,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.18"/>
      <path class="field-line" d="M80,180 Q90,260 85,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.14"/>

      <path class="field-line" d="M440,180 Q470,260 500,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.22"/>
      <path class="field-line" d="M440,180 Q450,260 465,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.18"/>
      <path class="field-line" d="M440,180 Q430,260 435,340" stroke="var(--color-electric)" stroke-width="1" fill="none" opacity="0.14"/>
    </svg>

    <div class="container page-head__grid">
      <div>
        <nav class="breadcrumbs" aria-label="Ruta de navegación">
          <a href="/proyectos">Proyectos</a>
          <span aria-hidden="true">/</span>
          <span>Caso TRE en suelos finos</span>
        </nav>
        <p class="eyebrow">Caso de estudio · Obra civil</p>
        <h1>{pageTitle}</h1>
        <p class="page-head__lead">
          Mediante Tomografía de Resistividad Eléctrica se obtuvo un modelo
          continuo de los primeros metros del subsuelo para orientar la mecánica
          de suelos, el diseño de cimentaciones y el manejo del agua.
        </p>
        <div class="actions">
          <Button href="/contacto" variant="primary">Solicitar evaluación</Button>
          <Button href="/proyectos" variant="secondary">Volver a proyectos</Button>
        </div>
      </div>
      <aside class="summary" aria-label="Resumen del caso">
        <dl>
          <div><dt>Ubicación general</dt><dd>Entorno urbano anonimizado</dd></div>
          <div><dt>Condición</dt><dd>Suelos finos con humedad variable</dd></div>
          <div><dt>Método</dt><dd>Tomografía de Resistividad Eléctrica (TRE)</dd></div>
          <div><dt>Aplicación</dt><dd>Evaluación preliminar para edificación</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container stats" aria-label="Cifras del estudio">
      {stats.map(([number, label]) => (
        <div class="stat">
          <strong>{number}</strong>
          <span>{label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--soft">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">El reto</p>
        <h2>Entender la influencia del agua antes de diseñar</h2>
      </div>
      <div class="copy">
        <p>
          El terreno presentaba condiciones compatibles con depósitos finos, cuyo
          comportamiento puede cambiar con el contenido de humedad. Antes de
          definir cimentaciones, losas, excavaciones y drenaje, era necesario
          conocer si existían zonas con respuestas anómalas.
        </p>
        <p>
          Una exploración puntual podía pasar por alto variaciones laterales
          importantes. La TRE permitió obtener una lectura continua para decidir
          dónde concentrar la verificación directa.
        </p>
        <p>
          La incertidumbre podía traducirse en asentamientos, expansión de suelos,
          drenaje deficiente, desempeño irregular de losas, ajustes de cimentación
          y mayores costos de mantenimiento.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">Método</p>
        <h2>Dos líneas de TRE para delimitar contrastes eléctricos</h2>
      </div>
      <div class="copy">
        <p>
          Se adquirieron dos perfiles de Tomografía de Resistividad Eléctrica en
          zonas representativas del predio. La configuración Wenner–Schlumberger
          permitió equilibrar sensibilidad a cambios laterales y verticales con
          una buena relación señal–ruido.
        </p>
        <p class="note">
          La TRE es un método indirecto: orienta la investigación geotécnica,
          pero no sustituye sondeos, muestreo ni ensayos de laboratorio o campo.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section__header">
        <p class="eyebrow">Resultados</p>
        <h2>Humedad y suelos finos como variables principales</h2>
      </div>
      <div class="result-grid">
        {findings.map((item) => (
          <article class="result-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
      <p class="result-note">
        Dentro de la profundidad investigada no se observaron respuestas
        eléctricas resistivas compatibles con cavidades. El foco técnico quedó en
        confirmar el contenido de humedad y el comportamiento geotécnico de los
        suelos finos.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">Valor aportado</p>
        <h2>Criterios para investigar y diseñar con menos incertidumbre</h2>
      </div>
      <ul class="value-list">
        {value.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">Decisiones que facilitó el estudio</p>
        <h2>Enfocar la verificación donde el agua y los finos importan más</h2>
      </div>
      <ul class="value-list">
        {decisions.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <div>
        <p class="eyebrow">Alcance y limitaciones</p>
        <h2>Qué puede y qué no puede confirmar una TRE</h2>
      </div>
      <ul class="value-list">
        {limitations.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--soft privacy">
    <div class="container">
      <p class="eyebrow">Privacidad del caso</p>
      <h2>Información publicada de forma anonimizada</h2>
      <p>
        Este caso omite municipio, coordenadas, calles, expediente catastral,
        nombre del proyecto o propietario, documentos firmados, mapas de
        ubicación y fotografías con referencias reconocibles.
      </p>
    </div>
  </section>

  <CtaBanner
    heading="¿Tu terreno presenta humedad, arcillas o dudas sobre cimentación?"
    text="Una TRE puede ayudarte a ubicar zonas críticas antes de invertir en obra."
    buttonLabel="Revisar mi caso"
  />

  <script type="application/ld+json" set:html={JSON.stringify(caseStudyJsonLd)} />
</Layout>

<style>
  .page-head {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-24) var(--space-16);
  }
  .page-head::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 90% at 85% 50%, rgba(0,168,204,0.09) 0%, transparent 65%),
      radial-gradient(ellipse 50% 70% at 15% 50%, rgba(0,80,120,0.06) 0%, transparent 55%);
    z-index: 0;
    pointer-events: none;
  }
  .page-head__field-art {
    position: absolute;
    right: -6%;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(280px, 42vw, 520px);
    height: auto;
    opacity: 0.13;
    z-index: 1;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .field-line {
      animation: fieldPulse 5s ease-in-out infinite;
    }
    @keyframes fieldPulse {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 0.7; }
    }
  }
  .page-head__grid,
  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr);
    gap: var(--space-12);
    align-items: start;
    position: relative;
    z-index: 2;
  }
  .page-head__lead {
    margin-top: var(--space-4);
    font-size: 1.125rem;
    color: var(--text-primary);
  }
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--text-secondary);
    font-size: var(--text-small);
  }
  .breadcrumbs a {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .summary,
  .result-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .summary {
    padding: var(--space-6);
  }
  .summary dl div {
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  .summary dl div:first-child {
    border-top: 0;
    padding-top: 0;
  }
  dt {
    font-family: var(--font-heading);
    font-size: var(--text-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }
  dd {
    margin-top: var(--space-1);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
  }
  .stat {
    padding: var(--space-6);
    border-left: 3px solid var(--color-electric);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .stat strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 2rem;
    line-height: 1;
    color: var(--color-accent-text);
  }
  .stat span {
    display: block;
    margin-top: var(--space-2);
    color: var(--text-secondary);
  }
  .copy p + p {
    margin-top: var(--space-4);
  }
  .note {
    padding: var(--space-4);
    border-left: 3px solid var(--color-electric);
    background: var(--color-surface);
  }
  .result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6);
  }
  .result-card {
    padding: var(--space-6);
  }
  .result-card h3 {
    margin-bottom: var(--space-3);
  }
  .result-card p,
  .result-note,
  .value-list,
  .privacy p {
    color: var(--text-secondary);
  }
  .result-note {
    margin-top: var(--space-8);
    max-width: 78ch;
  }
  .value-list {
    display: grid;
    gap: var(--space-3);
    list-style: disc;
    padding-left: var(--space-6);
  }
  .privacy p {
    margin-top: var(--space-4);
    max-width: 72ch;
  }
  @media (max-width: 760px) {
    .page-head__grid,
    .content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
