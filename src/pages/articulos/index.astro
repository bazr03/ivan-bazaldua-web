---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogCard from "../../components/BlogCard.astro";
import Button from "../../components/Button.astro";
import CtaBanner from "../../components/CtaBanner.astro";

const posts = await getCollection("articulos", ({ data }) => !data.draft);

// Sort by pubDate descending
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout
  title="Artículos — Geofísica aplicada y exploración del subsuelo | Iván Bazaldúa"
  description="Artículos sobre métodos geofísicos, exploración del subsuelo, geotecnia y casos de estudio. Escritos desde la práctica profesional."
>
  <section class="section--soft page-head">
    <div class="container">
      <p class="eyebrow">Artículos</p>
      <h1>Artículos</h1>
      <p class="page-head__lead">
        Artículos sobre métodos geofísicos, exploración del subsuelo y geotecnia.
        Desde la práctica profesional, sin tecnicismos innecesarios.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        posts.length > 0 ? (
          <div class="blog-grid">
            {posts.map((post) => {
              // Use explicit slug if provided, otherwise fall back to id
              const slug = post.data.slug ?? post.id;
              return (
                <BlogCard
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  slug={slug}
                  tags={post.data.tags}
                />
              );
            })}
          </div>
        ) : (
          <div class="empty-state">
            <h2>Próximamente</h2>
            <p>
              Estoy preparando artículos sobre métodos geofísicos, casos de estudio
              y mejores prácticas en exploración del subsuelo.
            </p>
            <Button href="/contacto" variant="primary">Sugerir un tema</Button>
          </div>
        )
      }
    </div>
  </section>

  <CtaBanner
    heading="¿Tienes un proyecto con incertidumbre geotécnica?"
    text="Escríbeme y platiquemos cómo la geofísica puede ayudarte a reducirla."
    buttonLabel="Contactar"
  />
</Layout>

<style>
  .page-head {
    padding-block: var(--space-24) var(--space-16);
  }
  .page-head__lead {
    max-width: 60ch;
    margin-top: var(--space-4);
    font-size: 1.125rem;
    color: var(--text-secondary);
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-8);
  }
  .empty-state {
    text-align: center;
    max-width: 560px;
    margin-inline: auto;
    padding: var(--space-16) var(--space-6);
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
  }
  .empty-state h2 {
    margin-bottom: var(--space-4);
  }
  .empty-state p {
    margin: var(--space-4) auto var(--space-8);
    color: var(--text-secondary);
  }
</style>
