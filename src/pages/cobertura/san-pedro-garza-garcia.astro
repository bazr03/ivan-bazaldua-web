---
import Layout from "../../layouts/Layout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { whatsappLink } from "../../data/site.ts";

const whatsappHref = `${whatsappLink}?text=${encodeURIComponent(
  "Hola Iván, necesito un estudio geofísico en San Pedro Garza García para revisión de proyecto.",
)}`;

const metodos = [
  {
    nombre: "Tomografía de Resistividad Eléctrica (TRE/ERT)",
    detalle:
      "Mapeo de contraste de materiales, profundidad a roca, identificación de zonas saturadas, rellenos o cavidades, y caracterización 2D del subsuelo.",
  },
  {
    nombre: "Tomografía de Refracción Sísmica (TRS)",
    detalle:
      "Estimación de velocidades sísmicas, profundidad a roca y estratificación del terreno en zona de ladera o montaña.",
  },
  {
    nombre: "MASW",
    detalle:
      "Perfiles de velocidad de onda de corte (Vs) y clasificación dinámica del suelo cuando el proyecto requiere rigidez sísmica.",
  },
];

const casos = [
  {
    titulo: "Zona de montaña con riesgos geológicos",
    texto:
      "Caracterización del subsuelo para evaluación de ladera, identificación de zonas de riesgo y soporte para revisión municipal.",
  },
  {
    titulo: "Construcción en ladera con posibles cavidades o rellenos",
    texto:
      "TRE y TRS para mapear el terreno antes de definir cimentación o corte.",
  },
  {
    titulo: "Proyecto residencial con nivel freático somero",
    texto:
      "TRE para evaluar profundidad de saturación y comportamiento del suelo bajo la cota de desplante.",
  },
];

const pasos = [
  {
    n: "01",
    titulo: "Contacto y objetivo",
    texto:
      "Me cuentas el proyecto, ubicación y qué te pidió el municipio.",
  },
  {
    n: "02",
    titulo: "Propuesta y método",
    texto:
      "Defino el alcance, los métodos y entrego cotización por escrito.",
  },
  {
    n: "03",
    titulo: "Trabajo de campo",
    texto:
      "Equipo portátil, no invasivo, sin excavación. Permiso y acceso coordinados contigo.",
  },
  {
    n: "04",
    titulo: "Informe y recomendaciones",
    texto:
      "Entregables con metodología, resultados interpretados, limitaciones y recomendaciones de verificación cuando aplique.",
  },
];

const diferenciadores = [
  {
    titulo: "M.C. en Geofísica Aplicada (CICESE)",
    texto: "Formación de posgrado respaldando cada estudio.",
  },
  {
    titulo: "Métodos no invasivos",
    texto: "Caracterizo el subsuelo sin excavar ni dañar el terreno.",
  },
  {
    titulo: "Interpretación, no solo datos",
    texto:
      "Entrego conclusiones y recomendaciones accionables, no números sueltos.",
  },
  {
    titulo: "Dominio técnico completo",
    texto:
      "Del trabajo de campo al procesamiento especializado (Res2DInv, ZondST2D, ResIPy y más).",
  },
  {
    titulo: "Conocimiento práctico del municipio",
    texto:
      "Experiencia directa con cómo Desarrollo Urbano de San Pedro aplica la revisión de proyecto.",
  },
];

const faqs = [
  {
    pregunta: "¿Cuánto cuesta un estudio geofísico en San Pedro?",
    respuesta:
      "El costo depende del método, ubicación dentro del municipio, longitud de líneas o número de puntos, accesibilidad del sitio, objetivo del estudio y entregables requeridos. Te envío una cotización por escrito cuando tengamos definidos el alcance y los datos del proyecto.",
  },
  {
    pregunta: "¿Cuánto tarda el estudio?",
    respuesta:
      "El trabajo de campo se ejecuta típicamente en 1-2 jornadas. El procesamiento e informe final depende del alcance.",
  },
  {
    pregunta: "¿El estudio satisface el requisito del municipio?",
    respuesta:
      "El estudio entrega información técnica interpretativa del subsuelo que sirve como soporte para revisión de proyecto. La aprobación final depende de Desarrollo Urbano de San Pedro según su criterio y el Atlas de Peligros y Riesgos vigente.",
  },
  {
    pregunta: "¿Pueden trabajar en zona de ladera o montaña?",
    respuesta:
      "Sí. TRE y TRS están diseñados específicamente para esas condiciones. Evalúo previamente la accesibilidad del sitio y defino el alcance según el objetivo.",
  },
  {
    pregunta: "¿Cubre también el diseño de cimentación?",
    respuesta:
      "No. El estudio geofísico entrega parámetros del subsuelo que el ingeniero civil o estructural usa para el diseño. El diseño estructural es un alcance independiente.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Estudio geofísico para revisión de proyecto municipal",
    provider: {
      "@type": "Person",
      name: "Iván Bazaldúa",
      jobTitle: "M.C. en Geofísica Aplicada",
    },
    areaServed: {
      "@type": "City",
      name: "San Pedro Garza García, Nuevo León",
    },
    description:
      "Estudio geofísico no invasivo (TRE, TRS, MASW) con informe interpretativo que sirve como soporte técnico para revisión de proyecto ante la Dirección de Desarrollo Urbano de San Pedro Garza García.",
    offers: {
      "@type": "Offer",
      availability: "https://schema.org/InStock",
      priceCurrency: "MXN",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.pregunta,
      acceptedAnswer: { "@type": "Answer", text: f.respuesta },
    })),
  },
];
---

<Layout
  title="Estudio geofísico en San Pedro Garza García, N.L. — Revisión de proyecto y dictamen | Iván Bazaldúa"
  description="Estudio geofísico no invasivo en San Pedro Garza García para arquitectos independientes: TRE, TRS y MASW. Soporte técnico para revisión de proyecto municipal con base en el Atlas de Peligros y Riesgos."
  ogType="article"
>
  <section class="section--soft page-head">
    <div class="container">
      <p class="eyebrow">Cobertura · San Pedro Garza García</p>
      <h1>Estudio geofísico en San Pedro Garza García</h1>
      <p class="page-head__lead">
        Para revisión de proyecto y dictamen con base en el Atlas de
        Peligros y Riesgos del municipio.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p>
        Si tu proyecto en San Pedro Garza García requiere revisión de la
        Dirección de Desarrollo Urbano o consulta con base en el Atlas de
        Peligros y Riesgos, realizo estudios geofísicos no invasivos que
        entregan la información del subsuelo que el municipio necesita para
        evaluar tu proyecto: profundidad a roca, contraste de materiales,
        nivel freático, presencia de rellenos o cavidades y rigidez
        dinámica del suelo.
      </p>
      <p>
        Atiendo a arquitectos independientes y profesionales que necesitan
        datos verificables, interpretaciones claras y un informe técnico que
        responda a la revisión municipal sin retrasar la entrega del
        proyecto.
      </p>
      <p class="cta-row">
        <a class="cta-primary" href={whatsappHref}>
          Evaluar mi proyecto en San Pedro por WhatsApp
        </a>
      </p>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="cuando-se-exige">
    <div class="container">
      <h2 id="cuando-se-exige">
        Cuándo se exige un estudio geofísico en San Pedro Garza García
      </h2>
      <p>
        San Pedro Garza García no tiene un reglamento de construcción
        específico para estudios geofísicos. La exigencia se determina en
        ventanilla durante la <strong>revisión de proyecto</strong>, con
        base en el <strong>Atlas de Peligros y Riesgos</strong> del
        municipio, y se activa bajo condiciones específicas que el equipo
        de Desarrollo Urbano evalúa caso por caso.
      </p>
      <p>
        Esta forma de trabajo significa que el arquitecto necesita a
        alguien que ya conozca cómo se aplica esa revisión en la práctica,
        no solo la teoría. Eso es lo que entrego.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="que-cubrimos">
    <div class="container">
      <div class="section__header">
        <p class="eyebrow">Servicios</p>
        <h2>Qué cubrimos técnicamente</h2>
      </div>
      <p>
        Cada proyecto se resuelve con uno o varios de estos métodos, según
        el objetivo:
      </p>
      <ul class="methods">
        {
          metodos.map((m) => (
            <li class="method">
              <h3>{m.nombre}</h3>
              <p>{m.detalle}</p>
            </li>
          ))
        }
      </ul>
      <p class="note">
        <strong>Importante</strong>: los métodos geofísicos son indirectos
        y ayudan a reducir incertidumbre. No sustituyen a sondeos,
        perforaciones o calicatas cuando el proyecto los requiere. El
        informe lo declara explícitamente.
      </p>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="casos-tipicos">
    <div class="container">
      <h2 id="casos-tipicos">Casos típicos en San Pedro Garza García</h2>
      <p>He trabajado en proyectos del municipio en zonas como:</p>
      <ul class="cases">
        {
          casos.map((c) => (
            <li class="case">
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="como-trabajamos">
    <div class="container">
      <div class="section__header">
        <p class="eyebrow">Proceso</p>
        <h2>Cómo trabajamos</h2>
      </div>
      <ol class="steps">
        {
          pasos.map((s) => (
            <li class="step">
              <span class="step__num">{s.n}</span>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <hr class="wave-divider" />

  <section class="section section--soft" aria-labelledby="por-que">
    <div class="container">
      <div class="section__header">
        <p class="eyebrow">Por qué trabajar conmigo</p>
        <h2>Rigor científico con enfoque práctico</h2>
      </div>
      <ul class="differentiators">
        {
          diferenciadores.map((d) => (
            <li class="differentiator">
              <h3>{d.titulo}</h3>
              <p>{d.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq">
    <div class="container">
      <div class="section__header">
        <p class="eyebrow">FAQ</p>
        <h2>Preguntas frecuentes</h2>
      </div>
      <ul class="faqs">
        {
          faqs.map((f) => (
            <li class="faq">
              <details>
                <summary>{f.pregunta}</summary>
                <p>{f.respuesta}</p>
              </details>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBanner heading="¿Tu proyecto en San Pedro requiere un estudio geofísico para revisión municipal?" />
</Layout>

<script
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>

<style>
  .page-head__lead {
    max-width: 60ch;
    margin-top: var(--space-4);
    font-size: 1.125rem;
    color: var(--text-primary);
  }

  .cta-row {
    margin-top: var(--space-6);
  }
  .cta-primary {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background: var(--color-electric);
    color: var(--color-white);
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-weight: var(--weight-heading-semibold);
    text-transform: uppercase;
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    transition: background var(--transition-base);
  }
  .cta-primary:hover {
    background: var(--color-accent);
  }

  .section p + p {
    margin-top: var(--space-4);
  }
  .section p {
    max-width: 70ch;
  }

  .section__header {
    margin-bottom: var(--space-6);
  }

  .note {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-6);
    background: var(--color-bg-soft);
    border-left: 3px solid var(--color-electric);
    border-radius: var(--radius-sm);
    max-width: 70ch;
  }

  .methods,
  .cases,
  .faqs,
  .differentiators {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .methods,
  .cases {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .differentiators {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .method,
  .case,
  .differentiator,
  .faq {
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .method h3,
  .case h3,
  .differentiator h3 {
    margin-bottom: var(--space-2);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    counter-reset: step;
  }
  .step {
    padding: var(--space-6);
    background: var(--color-bg-soft);
    border-radius: var(--radius-md);
  }
  .step__num {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading-bold);
    font-size: 2.5rem;
    color: var(--color-accent-text);
    line-height: 1;
  }
  .step h3 {
    margin-block: var(--space-3) var(--space-2);
    font-size: 1.25rem;
  }
  .step p {
    color: var(--text-secondary);
    font-size: var(--text-small);
  }

  .faqs {
    max-width: 800px;
    margin-inline: auto;
  }
  .faq details {
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-4);
  }
  .faq summary {
    cursor: pointer;
    font-family: var(--font-heading);
    font-weight: var(--weight-heading-semibold);
    font-size: 1.125rem;
    list-style: none;
    padding-right: var(--space-8);
    position: relative;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: "+";
    position: absolute;
    right: 0;
    top: 0;
    color: var(--color-electric);
    font-size: 1.5rem;
    line-height: 1;
  }
  .faq details[open] summary::after {
    content: "−";
  }
  .faq details p {
    margin-top: var(--space-3);
    color: var(--text-secondary);
  }

  .wave-divider {
    border: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-electric),
      transparent
    );
    margin-block: var(--space-12);
    opacity: 0.4;
  }

  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>