---
/**
 * Brand logomark — uses the PNG logomark (estratos, sin texto) served from
 * /public/img. Text block (name + role) stays as the wordmark companion.
 */
interface Props {
  size?: number;
  withText?: boolean;
  class?: string;
}
const { size = 44, withText = true, class: className = "" } = Astro.props;
---

<span class={`logo ${className}`}>
  <img
    class="logo__mark"
    src="/img/icbr_logo_5_estratos_sin_texto_transparente.png"
    width={Math.round((size * 482) / 216)}
    height={size}
    style="aspect-ratio: 482 / 216;"
    alt="Logotipo Iván Bazaldúa"
    loading="eager"
  />
  {
    withText && (
      <span class="logo__text">
        <span class="logo__name">Iván Bazaldúa</span>
        <span class="logo__role">M.C. Geofísica Aplicada</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .logo__mark {
    flex-shrink: 0;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .logo__name {
    font-family: var(--font-heading);
    font-weight: var(--weight-heading-bold);
    font-size: 1.125rem;
    color: var(--text-primary);
  }
  .logo__role {
    font-family: var(--font-body);
    font-weight: var(--weight-body-light);
    font-size: 0.7rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }
</style>
