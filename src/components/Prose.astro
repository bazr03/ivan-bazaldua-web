---
/**
 * Prose wrapper — applies article typography styles to slotted content.
 * Use inside the Layout for individual post pages.
 */
import "../styles/prose.css";
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    /* Constrain line length for readability */
    max-width: 70ch;
  }
  .prose :global(h2) {
    font-size: var(--text-h3);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }
  .prose :global(h3) {
    font-size: 1.25rem;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  .prose :global(p) {
    margin-bottom: var(--space-4);
    color: var(--text-primary);
    line-height: var(--leading-normal);
    max-width: none;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-6);
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin-bottom: var(--space-2);
    color: var(--text-primary);
    line-height: var(--leading-normal);
  }
  .prose :global(li p) {
    margin-bottom: var(--space-2);
  }
  .prose :global(strong) {
    font-weight: var(--weight-heading-semibold);
  }
  .prose :global(em) {
    font-style: italic;
  }
  .prose :global(a) {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .prose :global(a:hover) {
    color: var(--color-accent-hover);
  }
  .prose :global(blockquote) {
    border-left: 4px solid var(--color-electric);
    padding-left: var(--space-6);
    margin: var(--space-6) 0;
    color: var(--text-secondary);
    font-style: italic;
  }
  .prose :global(code) {
    font-family: monospace;
    font-size: 0.9em;
    background: var(--color-bg-soft);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
  }
  .prose :global(pre) {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    overflow-x: auto;
    margin: var(--space-6) 0;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-8) 0;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: var(--space-6) 0;
  }
</style>
